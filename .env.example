# Copy to .env.local and fill in. Never commit .env.local.
GROQ_API_KEY=
# Optional: used automatically if the primary key fails or is rate-limited
GROQ_API_KEY_BACKUP=
GROQ_MODEL=openai/gpt-oss-120b
# "live" = LLM only, "scripted" = no LLM, "hybrid" = LLM with scripted fallback (default)
DEMO_MODE=hybrid
